# 复制为 .env 后填写。没有配置 key 时，项目会自动走离线规则模式（MockLLM），
# 全部功能、评估、演示都能跑通，只是回答是模板生成的而不是大模型生成的。

# 任意 OpenAI 兼容接口：DeepSeek / 通义 / Moonshot / 智谱 / 千帆 v2 都可以
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 可选：本地路径覆盖
# CRM_DB_PATH=./data/crm.db
# KNOWLEDGE_DIR=./data/knowledge
