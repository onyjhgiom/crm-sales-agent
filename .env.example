# 复制为 .env 后填写。没有配置 key 时，项目会自动走离线规则模式（MockLLM），
# 全部功能、评估、演示都能跑通，只是回答是模板生成的而不是大模型生成的。

# 任意 OpenAI 兼容接口：DeepSeek / 通义 / Moonshot / 智谱 / 千帆 v2 都可以
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 可选：本地路径覆盖
# CRM_DB_PATH=./data/crm.db
# KNOWLEDGE_DIR=./data/knowledge
# RAG_TOP_K=4

# ---- 生产部署 / 推理性能（详见 README 第 10 节）----
# LLM_MODE: auto（有 Key 才在线，默认）/ offline（强制规则模板，零外部调用）/ llm（强制在线）
# 公网部署推荐 offline + USE_CHECKPOINTER=false：不发起模型调用、不保留会话状态。
# LLM_MODE=offline
# USE_CHECKPOINTER=false

# 模型调用：超时 / SDK 重试 / 最大输出 token / 熔断阈值与冷却秒数
# LLM_TIMEOUT=8
# LLM_MAX_RETRIES=1
# LLM_MAX_TOKENS=900
# LLM_CB_THRESHOLD=3
# LLM_CB_COOLDOWN=30

# 服务稳定性：会话数上限（FIFO 淘汰）/ 单 IP 每分钟限流 / 单请求超时 / 提问字数上限
# MAX_SESSIONS=256
# RATE_LIMIT_RPM=60
# REQUEST_TIMEOUT=15
# MAX_QUESTION_CHARS=500

# 服务监听与日志级别（python api/server.py 时生效；uvicorn 启动时用命令行参数）
# HOST=127.0.0.1
# PORT=8000
# LOG_LEVEL=INFO

# ---- 规划与工具层（全部带范围校验，填错自动回落默认值）----
# PLANNING_ENABLED=false           # 关掉规划层：所有问题都走单意图路径
# PLANNING_MAX_STEPS=4             # 复合任务最多拆几个子任务（1-12）
# TOOL_TIMEOUT_S=10                # 单工具调用软件超时秒数（0-60，0=不启用）
# TOOL_MAX_RETRIES=1               # 工具失败后的额外重试次数（0-5）
# TOOL_FALLBACK_ENABLED=false      # 关掉回退：工具失败直接返回错误结果
# DEGRADE_ON_EXTERNAL_FAILURE=false  # 外部服务挂掉时不再自动走本地降级（通常保持 true）
